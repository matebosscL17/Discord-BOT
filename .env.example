# Másold le ezt a fájlt .env néven, és töltsd ki. A .env-et SOHA ne oszd meg senkivel!

# --- KÖTELEZŐ ---
DISCORD_TOKEN=ide_jon_a_bot_tokenje
GUILD_ID=a_szervered_azonositoja
CHANGELOG_CHANNEL_ID=a_changelog_csatorna_azonositoja
SUPPORT_ROLE_ID=a_ticketeket_kezelo_rang_azonositoja

# --- NEM KÖTELEZŐ: ami üres, az a funkció egyszerűen nem fut ---
# Ebbe a kategóriába kerülnek a ticketek
TICKET_CATEGORY_ID=
# A napló és a privát frissítések csatornája. Ha üres, a settings.js értéke él.
LOG_CHANNEL_ID=
# Ezt a rangot pingeli a /changelog, ha bekapcsolod a ping opciót
CHANGELOG_PING_ROLE_ID=

# A következőkhöz a Discord fejlesztői oldalán a Bot fülön be kell kapcsolni:
# SERVER MEMBERS INTENT
WELCOME_CHANNEL_ID=
AUTO_ROLE_ID=
# MESSAGE CONTENT INTENT (és kell a LOG_CHANNEL_ID is). Értéke: true
ENABLE_TRANSCRIPT=
